diff --git a/adb/Android.bp b/adb/Android.bp
index dee48bf..d479a14 100644
--- a/adb/Android.bp
+++ b/adb/Android.bp
@@ -596,6 +596,41 @@ cc_binary {
     },
 }
 
+// Separate MTPADB daemon. The entry mode disables boot transports, while the
+// AOSP daemon services and TLS libraries remain available to project control.
+cc_binary {
+    name: "mtpadbd",
+    defaults: ["adbd_defaults", "host_adbd_supported", "libadbd_binary_dependencies"],
+
+    srcs: [
+        "daemon/main.cpp",
+    ],
+
+    cflags: [
+        "-DMTPADB_PROJECT_DAEMON=1",
+        "-D_GNU_SOURCE",
+        "-Wno-deprecated-declarations",
+    ],
+
+    strip: {
+        keep_symbols: true,
+    },
+
+    static_libs: [
+        "libadbd",
+        "libadbd_services",
+        "libasyncio",
+        "libcap",
+        "libminijail",
+        "libssl",
+    ],
+
+    shared_libs: [
+        "libadb_protos",
+        "libadbd_auth",
+    ],
+}
+
 phony {
     // Interface between adbd in a module and the system.
     name: "adbd_system_api",
