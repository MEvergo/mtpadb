+std::optional<uint32_t> mtpadbd_interface_index(const char* bind_address) {
+    if (bind_address == nullptr || bind_address[0] == '\0') return std::nullopt;
+    in_addr ipv4{};
+    in6_addr ipv6{};
+    int family = AF_UNSPEC;
+    const void* requested = nullptr;
+    if (inet_pton(AF_INET, bind_address, &ipv4) == 1) {
+        family = AF_INET;
+        requested = &ipv4;
+    } else if (inet_pton(AF_INET6, bind_address, &ipv6) == 1) {
+        family = AF_INET6;
+        requested = &ipv6;
+    } else {
+        return std::nullopt;
+    }
+
+    ifaddrs* interfaces = nullptr;
+    if (getifaddrs(&interfaces) != 0) return std::nullopt;
+    std::optional<uint32_t> result;
+    for (ifaddrs* interface = interfaces; interface != nullptr; interface = interface->ifa_next) {
+        if (interface->ifa_addr == nullptr || interface->ifa_addr->sa_family != family) continue;
+        const void* candidate = family == AF_INET
+                                        ? static_cast<const void*>(
+                                                  &reinterpret_cast<sockaddr_in*>(
+                                                           interface->ifa_addr)->sin_addr)
+                                        : static_cast<const void*>(
+                                                  &reinterpret_cast<sockaddr_in6*>(
+                                                           interface->ifa_addr)->sin6_addr);
+        const size_t address_size = family == AF_INET ? sizeof(ipv4) : sizeof(ipv6);
+        if (memcmp(candidate, requested, address_size) == 0) {
+            const uint32_t index = if_nametoindex(interface->ifa_name);
+            if (index != 0) result = index;
+            break;
+        }
+    }
+    freeifaddrs(interfaces);
+    return result;
+}
+
+bool register_mtpadbd_mdns_service(int service_index, const char* bind_address, uint16_t port) {
+    if (service_index != kADBSecurePairingServiceRefIndex &&
+        service_index != kADBSecureConnectServiceRefIndex) {
+        return false;
+    }
+    const auto interface_index = mtpadbd_interface_index(bind_address);
+    if (!interface_index.has_value()) return false;
+    start_mdnsd();
+    const std::string service_name = mtpadbd_adb_mdns_device_guid();
+    if (service_name.empty()) return false;
+
+    std::vector<char> txt_record;
+    if (kADBDNSServiceTxtRecords[service_index] != nullptr) {
+        const size_t txt_size = strlen(kADBDNSServiceTxtRecords[service_index]);
+        txt_record.resize(1 + txt_size);
+        txt_record[0] = static_cast<char>(txt_size);
+        memcpy(txt_record.data() + 1, kADBDNSServiceTxtRecords[service_index], txt_size);
+    }
+
+    std::lock_guard<std::mutex> lock(mdns_lock);
+    DNSServiceRef service_ref = nullptr;
+    const DNSServiceErrorType error = DNSServiceRegister(
+            &service_ref, 0, *interface_index, service_name.c_str(),
+            kADBDNSServices[service_index], nullptr, nullptr, htobe16(port),
+            static_cast<uint16_t>(txt_record.size()),
+            txt_record.empty() ? nullptr : txt_record.data(), mdns_callback, nullptr);
+    if (error != kDNSServiceErr_NoError) {
+        if (service_ref != nullptr) DNSServiceRefDeallocate(service_ref);
+        LOG(ERROR) << "Could not register project mDNS service "
+                   << kADBDNSServices[service_index] << ", error (" << error << ").";
+        return false;
+    }
+    if (mdns_registered[service_index]) DNSServiceRefDeallocate(mdns_refs[service_index]);
+    mdns_refs[service_index] = service_ref;
+    mdns_registered[service_index] = true;
+    return true;
+}
+
+void unregister_mtpadbd_mdns_service(int service_index) {
+    std::lock_guard<std::mutex> lock(mdns_lock);
+    if (!mdns_registered[service_index]) return;
+    DNSServiceRefDeallocate(mdns_refs[service_index]);
+    mdns_refs[service_index] = nullptr;
+    mdns_registered[service_index] = false;
+}
