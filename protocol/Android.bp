cc_library_static {
    name: "libmtprpc_protocol",
    host_supported: true,
    srcs: [
        "src/mtprpc_protocol.cpp",
        "src/mtprpc_crypto.cpp",
        "src/mtprpc_session.cpp",
    ],
    export_include_dirs: ["include"],
    cpp_std: "c++17",
    cppflags: ["-fexceptions"],
    target: {
        android: {
            shared_libs: ["libcrypto"],
        },
        host: {
            static_libs: ["libcrypto"],
        },
    },
}
