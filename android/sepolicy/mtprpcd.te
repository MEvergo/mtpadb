type mtprpcd, domain;
typeattribute mtprpcd coredomain;
type mtprpcd_exec, exec_type, file_type, system_file_type;
init_daemon_domain(mtprpcd)

type mtprpcd_socket, file_type, coredomain_socket;
type mtpadb_rpc_data_file, file_type, data_file_type, core_data_file_type;
allow mtprpcd mtprpcd_socket:sock_file { getattr read write };
allow mtprpcd self:unix_stream_socket { accept getattr getopt listen read setopt shutdown write };

allow mtprpcd system_data_file:dir { getattr open search };
allow mtprpcd adb_data_file:dir { getattr open search };
allow mtprpcd mtpadb_rpc_data_file:dir r_dir_perms;
allow mtprpcd mtpadb_rpc_data_file:file r_file_perms;
