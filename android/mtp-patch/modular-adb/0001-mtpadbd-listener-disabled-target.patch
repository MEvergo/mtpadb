+    ],
+    target: {
+        android: {
+            static_libs: [
+                "android_trade_in_mode_flags_cc_lib",
+            ],
+        },
+    },
+}
+
 cc_binary {
     name: "adbd.recovery",
     defaults: [
@@ -965,7 +985,45 @@
    test_suites: [
        "general-tests",
        "mts-adbd",
    ],
    require_root: true,
}

+// Opt-in only: requires a prepared image with the mtprpcd init service running.
+// Provision /data/adb/mtpadb/device.id and /data/adb/mtpadb/device.key.
+// Keep this test out of stock adbd_test and general-tests/mts-adbd suites.
+cc_test {
+    name: "mtpadbd_rpc_service_integration_test",
+    defaults: [
+        "adbd_defaults",
+        "libadbd_binary_dependencies",
+    ],
+    recovery_available: false,
+    srcs: [
+        "daemon/restart_service.cpp",
+        "daemon/services.cpp",
+        "daemon/shell_service.cpp",
+        "daemon/tradeinmode.cpp",
+        "test_utils/test_utils.cpp",
+        "shell_service_protocol.cpp",
+        ":mtpadbd_rpc_service_test_srcs",
+    ],
+    test_config: "adbd_test.xml",
+    target: {
+        android: {
+            static_libs: [
+                "android_trade_in_mode_flags_cc_lib",
+                "libmtpadbd_rpc_service",
+            ],
+        },
+    },
+    shared_libs: ["liblog"],
+    version_script: "adbd_test.map",
+    stl: "libc++_static",
+    static_libs: ADBD_TEST_LIBS + [
+        "libmtprpc_protocol",
+    ],
+    exclude_shared_libs: ADBD_TEST_LIBS,
+    test_suites: ["mtpadb-integration-tests"],
+    require_root: true,
+}
