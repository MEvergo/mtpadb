+std::string mtpadbd_adb_mdns_device_guid() {
+    std::string guid = android::base::GetProperty("persist.mtpadb.wifi.guid", "");
+    if (guid.empty()) {
+        guid = GenerateDeviceGuid();
+        CHECK(!guid.empty());
+        android::base::SetProperty("persist.mtpadb.wifi.guid", guid);
+    }
+    return guid;
+}
