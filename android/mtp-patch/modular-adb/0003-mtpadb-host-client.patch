--- a/Android.bp
+++ b/Android.bp
@@ -519,8 +519,33 @@
 cc_binary_host {
     name: "adb",
     defaults: ["adb_binary_host_defaults"],
 }
 
+cc_binary_host {
+    name: "mtpadb",
