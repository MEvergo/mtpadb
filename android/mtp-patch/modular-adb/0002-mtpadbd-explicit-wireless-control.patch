+int mtpadbd_bound_server(const std::string& address, uint16_t port) {
+    addrinfo hints{};
+    hints.ai_family = AF_UNSPEC;
+    hints.ai_socktype = SOCK_STREAM;
+    hints.ai_protocol = IPPROTO_TCP;
+    hints.ai_flags = AI_NUMERICHOST;
+    addrinfo* addresses = nullptr;
+    if (getaddrinfo(address.c_str(), nullptr, &hints, &addresses) != 0) return -1;
+
+    int server_fd = -1;
+    for (addrinfo* item = addresses; item != nullptr && server_fd < 0; item = item->ai_next) {
+        sockaddr_storage bound_address{};
+        if (item->ai_addrlen > sizeof(bound_address)) continue;
+        memcpy(&bound_address, item->ai_addr, item->ai_addrlen);
+        if (bound_address.ss_family == AF_INET) {
+            reinterpret_cast<sockaddr_in*>(&bound_address)->sin_port = htons(port);
+        } else if (bound_address.ss_family == AF_INET6) {
+            auto* address6 = reinterpret_cast<sockaddr_in6*>(&bound_address);
+            address6->sin6_port = htons(port);
+            if (IN6_IS_ADDR_LINKLOCAL(&address6->sin6_addr) && address6->sin6_scope_id == 0) {
+                ifaddrs* interfaces = nullptr;
+                if (getifaddrs(&interfaces) != 0) continue;
+                for (ifaddrs* interface = interfaces; interface != nullptr;
+                     interface = interface->ifa_next) {
+                    if (interface->ifa_addr == nullptr ||
+                        interface->ifa_addr->sa_family != AF_INET6) {
+                        continue;
+                    }
+                    auto* interface_address =
+                            reinterpret_cast<sockaddr_in6*>(interface->ifa_addr);
+                    if (memcmp(&interface_address->sin6_addr, &address6->sin6_addr,
+                               sizeof(address6->sin6_addr)) == 0) {
+                        address6->sin6_scope_id = if_nametoindex(interface->ifa_name);
+                        break;
+                    }
+                }
+                freeifaddrs(interfaces);
+                if (address6->sin6_scope_id == 0) continue;
+            }
+        } else {
+            continue;
+        }
+
+        int fd = socket(item->ai_family, SOCK_STREAM | SOCK_CLOEXEC, IPPROTO_TCP);
+        if (fd < 0) continue;
+        int enabled = 1;
+        setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &enabled, sizeof(enabled));
+        if (item->ai_family == AF_INET6 &&
+            setsockopt(fd, IPPROTO_IPV6, IPV6_V6ONLY, &enabled, sizeof(enabled)) != 0) {
+            close(fd);
+            continue;
+        }
+        if (bind(fd, reinterpret_cast<sockaddr*>(&bound_address), item->ai_addrlen) == 0 &&
+            listen(fd, 4) == 0) {
+            server_fd = fd;
+        } else {
+            close(fd);
+        }
+    }
+    freeaddrinfo(addresses);
+    return server_fd;
+}
+
+uint16_t mtpadbd_local_port(int fd) {
+    sockaddr_storage address{};
+    socklen_t size = sizeof(address);
+    if (getsockname(fd, reinterpret_cast<sockaddr*>(&address), &size) != 0) return 0;
+    if (address.ss_family == AF_INET) return ntohs(reinterpret_cast<sockaddr_in*>(&address)->sin_port);
+    if (address.ss_family == AF_INET6) return ntohs(reinterpret_cast<sockaddr_in6*>(&address)->sin6_port);
+    return 0;
+}
