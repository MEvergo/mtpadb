@@ -596,6 +599,41 @@ cc_binary {
     },
 }
 
+// Separate MTPADB daemon. The entry mode disables boot transports, while the
+// AOSP daemon services and TLS libraries remain available to project control.
+cc_binary {
+    name: "mtpadbd",
+    defaults: ["adbd_defaults", "host_adbd_supported", "libadbd_binary_dependencies"],
+
+    srcs: [
+        "daemon/main.cpp",
+    ],
+
+    cflags: [
+        "-DMTPADB_PROJECT_DAEMON=1",
+        "-D_GNU_SOURCE",
+        "-Wno-deprecated-declarations",
+    ],
+
+    strip: {
+        keep_symbols: true,
+    },
+
+    static_libs: [
+        "libadbd",
+        "libadbd_services",
+        "libasyncio",
+        "libcap",
+        "libminijail",
+        "libssl",
+    ],
+
+    shared_libs: [
+        "libadb_protos",
+        "libadbd_auth",
+    ],
+}
+
 phony {
     // Interface between adbd in a module and the system.
     name: "adbd_system_api",
@@ -676,11 +714,43 @@
     static_libs: [
         "libadbd",
         "libadbd_auth",
         "libbase",
         "libcrypto_utils",
         "libusb",
+        "libmtpadbd_rpc_service",
     ],
     test_suites: ["device-tests", "mts"],
     require_root: true,
 }
 
+// Opt-in only: run on a prepared image with mtprpcd running and the
+// root-provisioned /data/adb/mtpadb/device.id and device.key present.
+// This target is intentionally outside the stock adbd_test suites.
+cc_test {
+    name: "mtpadbd_rpc_service_integration_test",
+    defaults: ["adbd_defaults", "libadbd_binary_dependencies"],
+    recovery_available: false,
+    srcs: [
+        "daemon/services.cpp",
+        "daemon/shell_service.cpp",
+        "shell_service_protocol.cpp",
+        ":mtpadbd_rpc_service_test_srcs",
+    ],
+    test_config: "mtpadbd_rpc_service_integration_test.xml",
+    shared_libs: ["liblog"],
+    static_libs: [
+        "libadbd",
+        "libadbd_auth",
+        "libbase",
+        "libcrypto_utils",
+        "libusb",
+        "libmtprpc_protocol",
+    ],
+    target: {
+        android: {
+            static_libs: ["libmtpadbd_rpc_service"],
+        },
+    },
+    test_suites: ["mtpadb-integration-tests"],
+    require_root: true,
+}
