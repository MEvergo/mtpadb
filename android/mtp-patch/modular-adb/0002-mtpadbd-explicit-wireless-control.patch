+PairingServerCtx* mtpadbd_pairing_server_new_no_cert_on_address(
+        const uint8_t* password, size_t password_size, const PeerInfo* peer_info,
+        const char* bind_address, uint16_t port) {
+    CHECK(password != nullptr);
+    CHECK_GT(password_size, 0U);
+    CHECK(peer_info != nullptr);
+    CHECK(bind_address != nullptr);
+    CHECK_NE(bind_address[0], '\0');
+    auto rsa_2048 = CreateRSA2048Key();
+    auto x509_cert = GenerateX509Certificate(rsa_2048->GetEvpPkey());
+    std::string private_key_pem = Key::ToPEMString(rsa_2048->GetEvpPkey());
+    std::string certificate_pem = X509ToPEMString(x509_cert.get());
+    std::vector<uint8_t> password_data(password, password + password_size);
+    std::vector<uint8_t> certificate_data(certificate_pem.begin(), certificate_pem.end());
+    std::vector<uint8_t> private_key_data(private_key_pem.begin(), private_key_pem.end());
+    return new PairingServerCtx(password_data, *peer_info, certificate_data, private_key_data,
+                                port, bind_address);
