+namespace mtpadb::mtpadbd {
+namespace {
+
+class AospWirelessRuntime final : public WirelessRuntime {
+  public:
+    void Start(WirelessControl& control) {
+        {
+            std::lock_guard<std::mutex> lock(result_mutex_);
+            if (started_) return;
+            started_ = true;
+        }
+        control_ = &control;
+        adbd_auth_set_mtpadbd_public_key_enumerator(EnumeratePublicKeys, &control);
+        result_thread_ = std::thread([this]() { ProcessPairingResults(); });
+
+        const int listening_fd = android_get_control_socket("mtpadbd-control");
+        if (listening_fd < 0) {
+            PLOG(ERROR) << "Failed to get mtpadbd control socket";
+            return;
+        }
+        fcntl(listening_fd, F_SETFD, FD_CLOEXEC);
+        std::thread([listening_fd, &control]() {
+            run_wireless_control_server(listening_fd, control);
+            close(listening_fd);
+        }).detach();
+    }
+
+    std::optional<uint16_t> open_pairing_listener(std::string_view bind_address,
+                                                  uint16_t requested_port,
+                                                  std::string_view pairing_code) override {
+        std::lock_guard<std::mutex> lock(pairing_server_mutex_);
+        if (geteuid() != 0) {
+            LOG(ERROR) << "mtpadbd wireless pairing requires root-owned peer storage";
+            return std::nullopt;
+        }
+        if (pairing_server_ != nullptr || pairing_code.size() != 6) return std::nullopt;
+
+        const std::string device_guid = mtpadbd_adb_mdns_device_guid();
+        if (device_guid.empty()) return std::nullopt;
+        PeerInfo device_info{};
+        if (device_guid.size() >= sizeof(device_info.data)) return std::nullopt;
+        device_info.type = ADB_DEVICE_GUID;
+        std::memcpy(device_info.data, device_guid.c_str(), device_guid.size() + 1);
+
+        const auto* password = reinterpret_cast<const uint8_t*>(pairing_code.data());
+        PairingServerCtx* server = mtpadbd_pairing_server_new_no_cert_on_address(
+                password, pairing_code.size(), &device_info, std::string(bind_address).c_str(),
+                requested_port);
+        if (server == nullptr) return std::nullopt;
+        const uint16_t port = pairing_server_start(server, PairingResultCallback, this);
+        if (port == 0) {
+            pairing_server_destroy(server);
+            return std::nullopt;
+        }
+        pairing_server_ = server;
+        return port;
+    }
+
+    std::optional<uint16_t> open_connect_listener(std::string_view bind_address,
+                                                  uint16_t requested_port) override {
+        return mtpadbd_wifi_start_tls_server(std::string(bind_address), requested_port);
+    }
+
+    void close_pairing_listener() noexcept override {
+        PairingServerCtx* server = nullptr;
+        {
+            std::lock_guard<std::mutex> lock(pairing_server_mutex_);
+            server = std::exchange(pairing_server_, nullptr);
+        }
+        if (server != nullptr) pairing_server_destroy(server);
+    }
+
+    void close_connect_listener() noexcept override {
+        mtpadbd_wifi_stop_tls_server();
+    }
+
+    bool publish_pairing_mdns(std::string_view bind_address, uint16_t port) override {
+        const std::string address(bind_address);
+        return mtpadbd_register_adb_secure_pairing_service(address.c_str(), port);
+    }
+
+    bool publish_connect_mdns(std::string_view bind_address, uint16_t port) override {
+        const std::string address(bind_address);
+        return mtpadbd_register_adb_secure_connect_service(address.c_str(), port);
+    }
+
+    void remove_pairing_mdns() noexcept override {
+        mtpadbd_unregister_adb_secure_pairing_service();
+    }
+
+    void remove_connect_mdns() noexcept override {
+        mtpadbd_unregister_adb_secure_connect_service();
+    }
+
+  private:
+    static void EnumeratePublicKeys(void* opaque, mtpadbd_wireless_public_key_visitor visitor,
+                                    void* visitor_opaque) {
+        auto* control = static_cast<WirelessControl*>(opaque);
+        control->for_each_paired_peer([&](std::string_view, std::string_view public_key) {
+            visitor(visitor_opaque, public_key);
+        });
+    }
+
+    static void PairingResultCallback(const PeerInfo* peer_info, void* opaque) {
+        auto* runtime = static_cast<AospWirelessRuntime*>(opaque);
+        std::optional<std::string> public_key;
+        if (peer_info != nullptr && peer_info->type == ADB_RSA_PUB_KEY) {
+            const char* data = reinterpret_cast<const char*>(peer_info->data);
+            const void* terminator = std::memchr(data, '\0', sizeof(peer_info->data));
+            if (terminator != nullptr && data != static_cast<const char*>(terminator)) {
+                public_key.emplace(data, static_cast<const char*>(terminator) - data);
+            }
+        }
+        {
+            std::lock_guard<std::mutex> lock(runtime->result_mutex_);
+            runtime->pairing_results_.push_back(std::move(public_key));
+        }
+        runtime->result_cv_.notify_one();
+    }
+
+    static std::string PeerId(std::string_view public_key) {
+        std::array<uint8_t, SHA256_DIGEST_LENGTH> digest{};
+        SHA256(reinterpret_cast<const uint8_t*>(public_key.data()), public_key.size(), digest.data());
+        static constexpr char kHex[] = "0123456789abcdef";
+        std::string peer_id = "adb-";
+        peer_id.reserve(4 + digest.size() * 2);
+        for (uint8_t byte : digest) {
+            peer_id.push_back(kHex[byte >> 4]);
+            peer_id.push_back(kHex[byte & 0x0f]);
+        }
+        return peer_id;
+    }
+
+    void ProcessPairingResults() {
+        for (;;) {
+            std::optional<std::string> public_key;
+            bool have_result = false;
+            {
+                std::unique_lock<std::mutex> lock(result_mutex_);
+                result_cv_.wait_for(lock, std::chrono::milliseconds(250),
+                                    [this]() { return !pairing_results_.empty(); });
+                if (!pairing_results_.empty()) {
+                    have_result = true;
+                    public_key = std::move(pairing_results_.front());
+                    pairing_results_.pop_front();
+                }
+            }
+            control_->advance_time(WirelessControl::Clock::now());
+            if (!have_result) continue;
+            if (!public_key.has_value()) {
+                control_->advance_time(WirelessControl::Clock::time_point::max());
+                continue;
+            }
+
+            // Destroying the official context from this worker joins the callback
+            // worker. Only after that join may core state accept the new peer.
+            close_pairing_listener();
+            const std::string peer_id = PeerId(*public_key);
+            if (!control_->pairing_succeeded(peer_id, *public_key)) {
+                LOG(WARNING) << "mtpadbd ignored a pairing result that was no longer active";
+            }
+        }
+    }
+
+    WirelessControl* control_ = nullptr;
+    std::mutex pairing_server_mutex_;
+    PairingServerCtx* pairing_server_ = nullptr;
+    std::mutex result_mutex_;
+    std::condition_variable result_cv_;
+    std::deque<std::optional<std::string>> pairing_results_;
+    std::thread result_thread_;
+    bool started_ = false;
+};
+
+}  // namespace
+}  // namespace mtpadb::mtpadbd
+
+void mtpadbd_wireless_runtime_start() {
+    static auto* runtime = new mtpadb::mtpadbd::AospWirelessRuntime;
+    static auto* control = new mtpadb::mtpadbd::WirelessControl(*runtime);
+    runtime->Start(*control);
+}
